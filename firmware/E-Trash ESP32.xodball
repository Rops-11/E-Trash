hQf4TgTM2S0yDpM7xSma8ytSmzJSq0SPly4cpk9+aCEI3oncKKiPo4Zor8\nY/kB+Xj9e1x3+naH+uzfsQ55lVe0vSbv1gHR6xYKu44LtcXFilWr06zqkUspzBmk\nMiVOKvFlRNACzqrOSbTqn3yDsEB750Orp2yjj32JgfpMpf/VjsPOS+C12LOORc92\nwO1AK/1TD7Cn1TsNsYqiA94xrcx36m97PtbfkSIS5r762DL8EGMUUXLeXdYWk70p\naDPvOmbsB4om3xPXV2V4J95eSRQAogB/mqghtqmxlbCluQ0WEdrHbEg8QOB+DVrN\nVjzRlwW5y0vtOUucxD/SVRNuJLDWcfr0wbrM7Rv1/oFB2ACYPTrIrnqYNxgFlQID\nAQABo0IwQDAOBgNVHQ8BAf8EBAMCAYYwDwYDVR0TAQH/BAUwAwEB/zAdBgNVHQ4E\nFgQU5K8rJnEaK0gnhS9SZizv8IkTcT4wDQYJKoZIhvcNAQEMBQADggIBAJ+qQibb\nC5u+/x6Wki4+omVKapi6Ist9wTrYggoGxval3sBOh2Z5ofmmWJyq+bXmYOfg6LEe\nQkEzCzc9zolwFcq1JKjPa7XSQCGYzyI0zzvFIoTgxQ6KfF2I5DUkzps+GlQebtuy\nh6f88/qBVRRiClmpIgUxPoLW7ttXNLwzldMXG+gnoot7TiYaelpkttGsN/H9oPM4\n7HLwEXWdyzRSjeZ2axfG34arJ45JK3VmgRAhpuo+9K4l/3wV3s6MJT/KYnAK9y8J\nZgfIPxz88NtFMN9iiMG1D53Dn0reWVlHxYciNuaCp+0KueIHoI17eko8cdLiA6Ef\nMgfdG+RCzgwARWGAtQsgWSl4vflVy2PFPEz0tv/bal8xa5meLMFrUKTX5hgUvYU/\nZ6tGn6D/Qqc6f1zLXbBwHSs09dR2CQzreExZBfMzQsNhFRAbd03OIozUhfJFfbdT\n6u9AWpQKXCBfTkBdYiJ23//OYb2MI3jSNwLgjt7RETeJ9r/tSQdirpLsQBqvFAnZ\n0E6yove+7u7Y/9waLd64NnHi/Hm3lCXRSHNboTXns5lndcEZOitHTtNCjv0xyBZm\n2tIMPNuzjsmhDYAPexZ3FL//2wmUspO8IFgV6dtxQ/PeEMMA3KgqlbbC1j+Qa3bb\nbP6MvPJwNQzcmRk13NfIRmPVNnGuV/u3gm3c\n-----END CERTIFICATE-----\n-----BEGIN CERTIFICATE-----\nMIICCTCCAY6gAwIBAgINAgPluILrIPglJ209ZjAKBggqhkjOPQQDAzBHMQswCQYD\nVQQGEwJVUzEiMCAGA1UEChMZR29vZ2xlIFRydXN0IFNlcnZpY2VzIExMQzEUMBIG\nA1UEAxMLR1RTIFJvb3QgUjMwHhcNMTYwNjIyMDAwMDAwWhcNMzYwNjIyMDAwMDAw\nWjBHMQswCQYDVQQGEwJVUzEiMCAGA1UEChMZR29vZ2xlIFRydXN0IFNlcnZpY2Vz\nIExMQzEUMBIGA1UEAxMLR1RTIFJvb3QgUjMwdjAQBgcqhkjOPQIBBgUrgQQAIgNi\nAAQfTzOHMymKoYTey8chWEGJ6ladK0uFxh1MJ7x/JlFyb+Kf1qPKzEUURout736G\njOyxfi//qXGdGIRFBEFVbivqJn+7kAHjSxm65FSWRQmx1WyRRK2EE46ajA2ADDL2\n4CejQjBAMA4GA1UdDwEB/wQEAwIBhjAPBgNVHRMBAf8EBTADAQH/MB0GA1UdDgQW\nBBTB8Sa6oC2uhYHP0/EqEr24Cmf9vDAKBggqhkjOPQQDAwNpADBmAjEA9uEglRR7\nVKOQFhG/hMjqb2sXnh5GmCCbn9MN2azTL818+FsuVbu/3ZL3pAzcMeGiAjEA/Jdm\nZuVDFhOD3cffL74UOO0BzrEXGhF16b0DjyZ+hOXJYKaV11RZt+cRLInUue4X\n-----END CERTIFICATE-----\n-----BEGIN CERTIFICATE-----\nMIICCTCCAY6gAwIBAgINAgPlwGjvYxqccpBQUjAKBggqhkjOPQQDAzBHMQswCQYD\nVQQGEwJVUzEiMCAGA1UEChMZR29vZ2xlIFRydXN0IFNlcnZpY2VzIExMQzEUMBIG\nA1UEAxMLR1RTIFJvb3QgUjQwHhcNMTYwNjIyMDAwMDAwWhcNMzYwNjIyMDAwMDAw\nWjBHMQswCQYDVQQGEwJVUzEiMCAGA1UEChMZR29vZ2xlIFRydXN0IFNlcnZpY2Vz\nIExMQzEUMBIGA1UEAxMLR1RTIFJvb3QgUjQwdjAQBgcqhkjOPQIBBgUrgQQAIgNi\nAATzdHOnaItgrkO4NcWBMHtLSZ37wWHO5t5GvWvVYRg1rkDdc/eJkTBa6zzuhXyi\nQHY7qca4R9gq55KRanPpsXI5nymfopjTX15YhmUPoYRlBtHci8nHc8iMai/lxKvR\nHYqjQjBAMA4GA1UdDwEB/wQEAwIBhjAPBgNVHRMBAf8EBTADAQH/MB0GA1UdDgQW\nBBSATNbrdP9JNqPV2Py1PsVq8JQdjDAKBggqhkjOPQQDAwNpADBmAjEA6ED/g94D\n9J+uHXqnLrmvT/aDHQ4thQEd0dlq7A/Cr8deVl5c1RxYIigL9zC2L7F8AjEA8GE8\np/SgguMh1YQdc4acLa/KNJvxn7kjNuK8YAOdgLOaVsjh4rsUecrNIdSUtUlD\n-----END CERTIFICATE-----\n)ETRASHCERT\";\n\nstruct DeviceSettings {\n    unsigned long revision = 0;\n    float emptyCm = 30, fullCm = 2, temperatureLimit = 45, humidityLimit = 85;\n    bool buzzerEnabled = true;\n};\nbool validSettings(const DeviceSettings& s) {\n    return s.revision <= 2147483647UL && isfinite(s.emptyCm) && isfinite(s.fullCm) && isfinite(s.temperatureLimit) && isfinite(s.humidityLimit)\n        && s.emptyCm >= 3 && s.emptyCm <= 400 && s.fullCm >= 2 && s.emptyCm-s.fullCm >= 1\n        && s.temperatureLimit >= 0 && s.temperatureLimit <= 60 && s.humidityLimit >= 1 && s.humidityLimit <= 100;\n}\n\nstruct CloudSample {\n    unsigned long uptime;\n    DeviceSettings settings;\n    bool distanceValid, environmentValid;\n    float distance, fill, temperature, humidity;\n};\nstruct CloudConfig {\n    char url[256] = {0};\n    char token[2048] = {0};\n    QueueHandle_t queue = nullptr;\n    QueueHandle_t settingsQueue = nullptr;\n};\n::String cloudNumber(float n, bool valid) {\n    return valid && isfinite(n) ? ::String(n, 3) : ::String(\"null\");\n}\nvoid cloudTask(void* argument) {\n    CloudConfig* config = static_cast<CloudConfig*>(argument);\n    for (;;) {\n        CloudSample sample;\n        if (WiFi.status() == WL_CONNECTED && time(nullptr) > 1735689600 && xQueuePeek(config->queue, &sample, 0) == pdTRUE) {\n            const unsigned long elapsed = millis() - sample.uptime;\n            const bool dv = sample.distanceValid && elapsed < 5000;\n            const bool ev = sample.environmentValid && elapsed < 10000;\n            ::String body = \"{\\\"schema_version\\\":1,\\\"device_id\\\":\\\"e-trash-\";\n            body += ::String((uint32_t)(ESP.getEfuseMac() & 0xFFFFFF), HEX);\n            body += \"\\\",\\\"uptime_ms\\\":\" + ::String(sample.uptime);\n            body += \",\\\"distance_valid\\\":\" + ::String(dv ? \"true\" : \"false\");\n            body += \",\\\"environment_valid\\\":\" + ::String(ev ? \"true\" : \"false\");\n            body += \",\\\"distance_m\\\":\" + cloudNumber(sample.distance, dv);\n            body += \",\\\"fill_percent\\\":\" + cloudNumber(sample.fill, dv);\n            body += \",\\\"temperature_c\\\":\" + cloudNumber(sample.temperature, ev);\n            body += \",\\\"humidity_percent\\\":\" + cloudNumber(sample.humidity, ev);\n            body += \",\\\"applied_settings\\\":{\\\"revision\\\":\" + ::String(sample.settings.revision);\n            body += \",\\\"empty_distance_cm\\\":\" + ::String(sample.settings.emptyCm,2);\n            body += \",\\\"full_distance_cm\\\":\" + ::String(sample.settings.fullCm,2);\n            body += \",\\\"temperature_threshold_c\\\":\" + ::String(sample.settings.temperatureLimit,2);\n            body += \",\\\"humidity_threshold_percent\\\":\" + ::String(sample.settings.humidityLimit,2);\n            body += \",\\\"buzzer_enabled\\\":\" + ::String(sample.settings.buzzerEnabled ? \"true\" : \"false\") + \"}}\";\n            WiFiClientSecure client;\n            client.setCACert(CLOUD_ROOTS);\n            client.setHandshakeTimeout(5);\n            HTTPClient http;\n            http.setConnectTimeout(5000);\n            http.setTimeout(5000);\n            if (http.begin(client, config->url)) {\n                http.addHeader(\"Content-Type\", \"application/json\");\n                http.addHeader(\"Authorization\", ::String(\"Bearer \") + config->token);\n                const int status = http.POST(body);\n                // Print only a result code, never credentials or request headers.\n                Serial.print(\"E-Trash cloud HTTP: \"); Serial.println(status);\n                http.end();\n            }\n        }\n\n            // Pull desired settings over the same authenticated, verified HTTPS connection.\n            const ::String telemetryUrl(config->url);\n            const int suffix = telemetryUrl.indexOf(\"/api/v1/telemetry\");\n            if (suffix > 0 && WiFi.status()==WL_CONNECTED && time(nullptr)>1735689600) {\n                WiFiClientSecure settingsClient; settingsClient.setCACert(CLOUD_ROOTS); settingsClient.setHandshakeTimeout(5);\n                HTTPClient settingsHttp;\n                settingsHttp.setConnectTimeout(5000); settingsHttp.setTimeout(5000);\n                if (settingsHttp.begin(settingsClient, telemetryUrl.substring(0,suffix)+\"/api/v1/device-settings\")) {\n                    settingsHttp.addHeader(\"Authorization\", ::String(\"Bearer \")+config->token);\n                    if (settingsHttp.GET() == 200 && settingsHttp.getSize() <= 256) {\n                        const ::String line = settingsHttp.getString();\n                        DeviceSettings next; int enabled=-1, consumed=0;\n                        const int fields=sscanf(line.c_str(),\"%lu,%f,%f,%f,%f,%d%n\",&next.revision,&next.emptyCm,&next.fullCm,&next.temperatureLimit,&next.humidityLimit,&enabled,&consumed);\n                        next.buzzerEnabled = enabled==1;\n                        if (fields==6 && consumed==(int)line.length() && (enabled==0 || enabled==1) && validSettings(next)) xQueueOverwrite(config->settingsQueue,&next);\n                    }\n                    settingsHttp.end();\n                }\n            }\n\n        vTaskDelay(pdMS_TO_TICKS(30000));\n    }\n}\n\nconst char DASHBOARD[] PROGMEM = R\"ETRASHHTML(<!doctype html>\n<html lang=\"en\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>E-Trash | Bin monitor</title>\n<style>\n:root{font-family:system-ui,sans-serif;color:#183b32;background:#f1f5ef}*{box-sizing:border-box}body{margin:0}main{max-width:1000px;margin:auto;padding:32px 22px}header{display:flex;justify-content:space-between;align-items:center;gap:16px;border-bottom:1px solid #cbd8ce;padding-bottom:22px}.brand{font-weight:800;letter-spacing:-1px;font-size:25px}.badge{border-radius:30px;padding:9px 14px;background:#dfe8df;font-size:13px}h1{font-size:clamp(32px,6vw,58px);letter-spacing:-2px;margin:40px 0 8px}p{color:#586c62;line-height:1.6}.grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:16px;margin:28px 0}.card{padding:26px;background:white;border-radius:20px;box-shadow:0 4px 22px #193d3210}.label{text-transform:uppercase;font-size:12px;letter-spacing:1.3px;color:#66776d}.number{font-size:42px;font-weight:750;margin:18px 0}.meter{height:12px;background:#e8eee7;border-radius:12px;overflow:hidden}.bar{height:100%;width:0;background:#3f8262;transition:width .4s}.status{border-left:5px solid #a4b4a6}.status h2{font-size:20px;margin:0 0 8px}button{border:0;border-radius:12px;padding:12px 18px;background:#214d3c;color:white;cursor:pointer}button:focus-visible{outline:3px solid #dd9e40;outline-offset:3px}footer{display:flex;justify-content:space-between;align-items:center;gap:15px;margin:25px 0;font-size:13px;color:#66776d}@media(max-width:700px){.grid{grid-template-columns:1fr}.number{margin:12px 0}header{align-items:flex-start}}\n</style>\n<main><header><div class=\"brand\">E-Trash<span style=\"color:#66946c\"> / </span>Monitor</div><span class=\"badge\" id=\"connection\">Waiting for device</span></header>\n<h1>A clearer view<br>of your bin.</h1><p>Live fill level and environmental readings from your ESP32.</p>\n<section class=\"grid\" aria-label=\"Sensor readings\"><article class=\"card\"><div class=\"label\">Bin fill level</div><div class=\"number\" id=\"fill\">\u2014</div><div class=\"meter\" role=\"meter\" aria-label=\"Bin fill level\" aria-valuemin=\"0\" aria-valuemax=\"100\" id=\"meter\"><div class=\"bar\" id=\"bar\"></div></div><p id=\"distance\">Waiting for a distance reading</p></article><article class=\"card\"><div class=\"label\">Temperature</div><div class=\"number\" id=\"temperature\">\u2014</div><p>Configured temperature alert</p></article><article class=\"card\"><div class=\"label\">Humidity</div><div class=\"number\" id=\"humidity\">\u2014</div><p>Configured humidity alert</p></article></section>\n<section class=\"card status\" aria-live=\"polite\"><h2 id=\"state\">Waiting for readings</h2><div id=\"message\">Open this dashboard at your ESP32's local IP address after connecting it to Wi-Fi.</div></section>\n<footer><span id=\"updated\">No live data received</span><button id=\"refresh\" type=\"button\">Refresh readings</button></footer><p style=\"font-size:12px\">Read-only monitoring \u00b7 refreshes every 30 seconds \u00b7 missing or stale sensor readings are shown as unavailable</p></main>\n<script>\nconst $=id=>document.getElementById(id);let busy=false;\nconst number=(n,lo,hi)=>typeof n==='number'&&Number.isFinite(n)&&n>=lo&&n<=hi;\nfunction clearReadings(){$('fill').textContent=$('temperature').textContent=$('humidity').textContent='\u2014';$('bar').style.width='0%';$('meter').removeAttribute('aria-valuenow');$('distance').textContent='No current distance reading';}\nasync function refresh(){if(busy)return;busy=true;$('refresh').disabled=true;try{\nconst response=await fetch('/api/v1/status',{cache:'no-store',signal:AbortSignal.timeout(4000)});if(!response.ok)throw Error('Device request failed');const d=await response.json();\nconst bin=d.distance_valid===true&&number(d.fill_percent,0,100)&&number(d.distance_m,0,100);\nconst env=d.environment_valid===true&&number(d.temperature_c,-50,100)&&number(d.humidity_percent,0,100);\n$('fill').textContent=bin?Math.round(d.fill_percent)+'%':'\u2014';$('bar').style.width=bin?d.fill_percent+'%':'0%';if(bin)$('meter').setAttribute('aria-valuenow',String(d.fill_percent));else $('meter').removeAttribute('aria-valuenow');\n$('distance').textContent=bin?'Distance to contents: '+(d.distance_m*100).toFixed(1)+' cm':'Distance sensor unavailable';$('temperature').textContent=env?d.temperature_c.toFixed(1)+'\u00b0C':'\u2014';$('humidity').textContent=env?Math.round(d.humidity_percent)+'%':'\u2014';\nconst full=bin&&Math.round(d.fill_percent)>80,hot=env&&d.temperature_c>(d.temperature_threshold_c??45),humid=env&&d.humidity_percent>(d.humidity_threshold_percent??85);\nconst notes=[];if(full)notes.push('Bin is full. Please empty it.');if(hot)notes.push('Temperature is high.');if(humid)notes.push('Humidity is high.');if(!bin)notes.push('Distance reading missing or stale.');if(!env)notes.push('Temperature and humidity readings missing or stale.');\n$('state').textContent=full||hot||humid?'Attention needed':!bin||!env?'Check sensors':'Bin operating normally';$('message').textContent=notes.join(' ')||'Fill level, temperature and humidity are within the configured limits.';$('connection').textContent='Device connected';$('updated').textContent='Last checked '+new Date().toLocaleTimeString();\n}catch(e){clearReadings();$('connection').textContent='Device unavailable';$('state').textContent='No live connection';$('message').textContent='Check ESP32 power and Wi-Fi. Open this page using the device\u2019s IP address on the same network.';$('updated').textContent='Latest request failed; readings cleared';}finally{busy=false;$('refresh').disabled=false;}}\n$('refresh').addEventListener('click',refresh);refresh();setInterval(refresh,30000);\n</script></html>)ETRASHHTML\";\n}\n\n#pragma XOD error_catch enable\nnode {\n    WebServer* server = nullptr;\n    bool seenDistance = false, seenEnvironment = false;\n    bool distanceOK = false, environmentOK = false;\n    unsigned long distanceAt = 0, environmentAt = 0, reconnectAt = 0;\n    float distance = 0, fill = 0, temperature = 0, humidity = 0;\n    bool announced = false;\n    CloudConfig* cloud = nullptr;\n    DeviceSettings settings;\n    Preferences preferences;\n    bool preferencesReady = false;\n\n    ::String jsonNumber(float value, bool valid) {\n        return valid && isfinite(value) ? ::String(value, 3) : ::String(\"null\");\n    }\n\n\n    void emitSettings(Context ctx) {\n        emitValue<output_EMPTY_M>(ctx, settings.emptyCm/100.0f);\n        emitValue<output_FULL_M>(ctx, settings.fullCm/100.0f);\n        emitValue<output_TEMP_LIMIT>(ctx, settings.temperatureLimit);\n        emitValue<output_HUM_LIMIT>(ctx, settings.humidityLimit);\n        emitValue<output_BUZZER_EN>(ctx, settings.buzzerEnabled);\n    }\n\n    void evaluate(Context ctx) {\n        if (isSettingUp()) {\n            \n            preferencesReady = preferences.begin(\"etrash-config\", false);\n            DeviceSettings saved;\n            if (preferencesReady && preferences.getBytesLength(\"settings-v1\")==sizeof(saved)) {\n                preferences.getBytes(\"settings-v1\",&saved,sizeof(saved));\n                if (validSettings(saved)) settings=saved;\n            }\n            emitSettings(ctx);\n\n            char ssid[33] = {0}, password[65] = {0};\n            size_t i = 0;\n            auto s = getValue<input_SSID>(ctx);\n            for (auto it = s.iterate(); it && i < 32; ++it) ssid[i++] = *it;\n            i = 0;\n            auto p = getValue<input_PASS>(ctx);\n            for (auto it = p.iterate(); it && i < 64; ++it) password[i++] = *it;\n            WiFi.mode(WIFI_STA);\n            WiFi.setHostname(\"e-trash\");\n            WiFi.setAutoReconnect(true);\n            if (ssid[0] && ::String(ssid) != \"YOUR_WIFI_NAME\") WiFi.begin(ssid, password);\n            Serial.begin(115200);\n            server = new WebServer(80);\n            server->on(\"/\", HTTP_GET, [this]() {\n                server->sendHeader(\"Cache-Control\", \"no-store\");\n                server->send_P(200, \"text/html; charset=utf-8\", DASHBOARD);\n            });\n            server->on(\"/api/v1/status\", HTTP_GET, [this]() {\n                const unsigned long now = millis();\n                const bool dv = seenDistance && distanceOK && (unsigned long)(now-distanceAt) < 5000;\n                const bool ev = seenEnvironment && environmentOK && (unsigned long)(now-environmentAt) < 10000;\n                ::String body = \"{\\\"schema_version\\\":1,\\\"device_id\\\":\\\"e-trash-\";\n                body += ::String((uint32_t)(ESP.getEfuseMac() & 0xFFFFFF), HEX);\n                body += \"\\\",\\\"uptime_ms\\\":\" + ::String(now);\n                body += \",\\\"distance_valid\\\":\" + ::String(dv ? \"true\" : \"false\");\n                body += \",\\\"environment_valid\\\":\" + ::String(ev ? \"true\" : \"false\");\n                body += \",\\\"distance_m\\\":\" + jsonNumber(distance, dv);\n                body += \",\\\"fill_percent\\\":\" + jsonNumber(fill, dv);\n                body += \",\\\"temperature_c\\\":\" + jsonNumber(temperature, ev);\n                body += \",\\\"humidity_percent\\\":\" + jsonNumber(humidity, ev);\n                body += \",\\\"distance_age_ms\\\":\" + (seenDistance ? ::String((unsigned long)(now-distanceAt)) : ::String(\"null\"));\n                body += \",\\\"environment_age_ms\\\":\" + (seenEnvironment ? ::String((unsigned long)(now-environmentAt)) : ::String(\"null\"));\n                body += \",\\\"bin_full\\\":\" + ::String(dv && roundf(fill)>80 ? \"true\" : \"false\");\n                body += \",\\\"environment_alert\\\":\" + ::String(ev && (temperature>settings.temperatureLimit || humidity>settings.humidityLimit) ? \"true\" : \"false\");\n                body += \",\\\"temperature_threshold_c\\\":\" + ::String(settings.temperatureLimit,2);\n                body += \",\\\"humidity_threshold_percent\\\":\" + ::String(settings.humidityLimit,2);\n                body += \",\\\"buzzer_enabled\\\":\" + ::String(settings.buzzerEnabled ? \"true\" : \"false\");\n                body += \",\\\"applied_revision\\\":\" + ::String(settings.revision);\n                body += \"}\";\n                server->sendHeader(\"Cache-Control\", \"no-store\");\n                server->send(200, \"application/json\", body);\n            });\n            server->onNotFound([this]() { server->send(404, \"text/plain\", \"Not found\"); });\n            server->begin();\n\n            // Cloud credentials stay in the local firmware configuration.\n            CloudConfig* config = new CloudConfig();\n            i = 0;\n            auto url = getValue<input_CLOUD_URL>(ctx);\n            for (auto it = url.iterate(); it && i < sizeof(config->url)-1; ++it) config->url[i++] = *it;\n            i = 0;\n            auto token = getValue<input_TOKEN>(ctx);\n            for (auto it = token.iterate(); it && i < sizeof(config->token)-1; ++it) config->token[i++] = *it;\n            if (::String(config->url).startsWith(\"https://\") && config->token[0] && ::String(config->token) != \"PASTE_DEVICE_API_TOKEN\") {\n                config->queue = xQueueCreate(1, sizeof(CloudSample));\n                config->settingsQueue = xQueueCreate(1,sizeof(DeviceSettings));\n                // Obtain real UTC time for certificate validity checks; no insecure TLS fallback.\n                configTime(0, 0, \"pool.ntp.org\", \"time.google.com\");\n                if (config->queue && config->settingsQueue && xTaskCreate(cloudTask, \"etrash-cloud\", 16384, config, 1, nullptr) == pdPASS) {\n                    cloud = config;\n                } else {\n                    if (config->queue) vQueueDelete(config->queue);\n                    if (config->settingsQueue) vQueueDelete(config->settingsQueue);\n                    delete config;\n                    Serial.println(\"E-Trash cloud task could not start\");\n                }\n            } else {\n                delete config;\n                Serial.println(\"E-Trash cloud: configure HTTPS URL and device API token\");\n            }\n\n        }\n        if (isInputDirty<input_DISTANCE_OK>(ctx)) {\n            seenDistance = true; distanceAt = millis();\n            distanceOK = !getError<input_DISTANCE>(ctx);\n            if (distanceOK) {\n                distance = getValue<input_DISTANCE>(ctx);\n                distanceOK = isfinite(distance) && distance >= 0;\n            }\n        }\n        if (isInputDirty<input_ENV_OK>(ctx)) {\n            seenEnvironment = true; environmentAt = millis();\n            environmentOK = !getError<input_TEMP>(ctx) && !getError<input_HUMIDITY>(ctx);\n            if (environmentOK) {\n                temperature = getValue<input_TEMP>(ctx); humidity = getValue<input_HUMIDITY>(ctx);\n                environmentOK = isfinite(temperature) && isfinite(humidity) && humidity >= 0 && humidity <= 100;\n            }\n        }\n\n        if (cloud) {\n            DeviceSettings desired;\n            if (xQueueReceive(cloud->settingsQueue,&desired,0)==pdTRUE && validSettings(desired) && desired.revision>settings.revision) {\n                // Acknowledge only after durable storage succeeds. Retain the last good values offline.\n                if (preferencesReady && preferences.putBytes(\"settings-v1\",&desired,sizeof(desired))==sizeof(desired)) {\n                    settings=desired; emitSettings(ctx);\n                }\n            }\n        }\n        if (seenDistance && distanceOK) {\n            fill=fmaxf(0.0f,fminf(100.0f,100.0f*(settings.emptyCm-distance*100.0f)/(settings.emptyCm-settings.fullCm)));\n        }\n\n        if (WiFi.status() == WL_CONNECTED) {\n            if (!announced) { Serial.print(\"E-Trash dashboard: http://\"); Serial.println(WiFi.localIP()); announced = true; }\n        } else {\n            announced = false;\n            if ((unsigned long)(millis()-reconnectAt) >= 30000) { WiFi.reconnect(); reconnectAt = millis(); }\n        }\n        \n        if (cloud) {\n            const unsigned long now = millis();\n            CloudSample sample = {now, settings,\n                seenDistance && distanceOK && (unsigned long)(now-distanceAt) < 5000,\n                seenEnvironment && environmentOK && (unsigned long)(now-environmentAt) < 10000,\n                distance, fill, temperature, humidity};\n            xQueueOverwrite(cloud->queue, &sample);\n        }\n\n        if (server) server->handleClient();\n        setTimeout(ctx, 10);\n    }\n}\n"
        }
      ]
    }
  },
  "name": "e-trash-wroom32-controls"
}